# Nastavení služby Závady vozů na serveru (noční zálohy a pravidelné exporty na e-mail).
# Zkopírujte jako server/.env a vyplňte. Hodnoty vkládejte za "=" bez uvozovek a bez mezer.
# Soubor .env se NIKDY nenahrává na GitHub (je v .gitignore); na server ho nahraje deploy.sh.

# Supabase → Project Settings → Data API (Project URL)
SUPABASE_URL=https://tfbirhsjavejkyscmacw.supabase.co
# Supabase → Project Settings → API Keys → Secret keys (začíná sb_secret_…). Tajné – nikomu neposílejte.
SUPABASE_SECRET_KEY=
# Supabase → tlačítko Connect → Connection string → „Session pooler“ (URI).
# Místo [YOUR-PASSWORD] vložte heslo k databázi (to, které jste ukládal při zakládání projektu).
SUPABASE_DB_URL=

# E-mail přes Gmail: heslo pro aplikace z https://myaccount.google.com/apppasswords (16 znaků, bez mezer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=zikmundmartin7@gmail.com
SMTP_PASSWORD=
MAIL_FROM_NAME=Závady vozů
# Kam poslat upozornění, když se záloha nebo export nepovede
ALERT_EMAIL=zikmundmartin7@gmail.com

BACKUP_DIR=/var/backups/zavady
APP_URL=https://zikmundmartin7-lab.github.io/zavady-vozu/
